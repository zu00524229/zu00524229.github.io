---
const skills = [
  { icon: 'fa-brands fa-html5',      label: 'HTML5',      value: 70, color: '#f16529' },
  { icon: 'fa-brands fa-css3-alt',   label: 'CSS',        value: 40, color: '#2965f1' },
  { icon: 'fa-brands fa-js',         label: 'JavaScript', value: 15, color: '#f7df1e' },
  { icon: 'fa-brands fa-python',     label: 'Python',     value: 60, color: '#3572A5' },
  { icon: 'fa-solid fa-gamepad',     label: 'pygame',     value: 50, color: '#39ff14' },
  { icon: 'fa-brands fa-php',        label: 'PHP',        value: 55, color: '#777bb4' },
  { icon: 'fa-brands fa-laravel',    label: 'Laravel',    value: 65, color: '#ff2d20' },
  { icon: 'fa-brands fa-unity',      label: 'Unity2D',    value: 40, color: '#ffffff' },
  { icon: 'fa-brands fa-bootstrap',  label: 'Bootstrap',  value: 50, color: '#7952b3' },
];

const base = import.meta.env.BASE_URL;
const demos = [
  { src: `${base}images/ninja.gif`,   alt: 'NinjaGame',   align: 'flex-start' },
  { src: `${base}images/Runner.gif`,  alt: '勇者無懼',    align: 'flex-end'   },
  { src: `${base}images/doom2D.gif`,  alt: 'Doom 仿 3D',  align: 'flex-start' },
];
---

<section id="MySkill" class="section container py-5">
  <h2 class="text-center mb-4">核心技能</h2>

  <div class="row">
    <!-- 技能進度條 -->
    <div class="col-lg-6 col-md-6 col-sm-12 mb-4">
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td colspan="3" style="font-size: 1.2rem; padding: 10px 0;">穩定升級中....</td>
        </tr>
        {skills.map((skill) => (
          <tr>
            <td style="width: 40px; text-align: center;">
              <i class={skill.icon} style={`font-size: 30px; color: ${skill.color};`}></i>
            </td>
            <td style="font-size: 1.2rem; white-space: nowrap; padding-right: 10px;">
              {skill.label}
            </td>
            <td style="width: 100%;">
              <progress value={skill.value} max="100" class="pixel-progress w-100"></progress>
            </td>
          </tr>
        ))}
      </table>
    </div>

    <!-- 遊戲演示 GIF -->
    <div class="col-lg-6 col-md-6 col-sm-12 mb-4">
      <div class="card p-3 shadow-sm border-primary d-flex flex-column align-items-start">
        <p><strong>遊戲演示：</strong></p>
        {demos.map((demo) => (
          <img
            src={demo.src}
            alt={demo.alt}
            class="img-fluid pixel-gif mb-2"
            style={`max-width: 350px; align-self: ${demo.align};`}
          />
        ))}
      </div>
    </div>
  </div>

  <!-- Typed.js 動態文字 -->
  <div class="card mt-3 border-success p-3" style="height: 230px;">
    <div id="typed7"></div>
  </div>

  <!-- 底部裝飾 -->
  <div class="text-center mt-3">
    <img src={`${base}images/ground.png`} alt="Ground" class="img-fluid" style="max-width: 350px;" />
  </div>
</section>
