---
const base = import.meta.env.BASE_URL;
const projects = [
  {
    id: 'learn4',
    titleZh: 'NinjaGame',
    titleEn: 'NinjaGame',
    img: `${base}images/ninja.gif`,
    alt: 'NinjaGame — Pygame 衝刺閃避動作遊戲',
    useLightbox: false,
  },
  {
    id: 'learn1',
    titleZh: '火鍋下樓梯',
    titleEn: 'Hotpot Stairs',
    img: `${base}images/gm1.gif`,
    alt: '火鍋下樓梯 — Unity 物理碰撞遊戲',
    useLightbox: false,
  },
  {
    id: 'learn2',
    titleZh: '勇者無懼',
    titleEn: 'Fearless Hero',
    img: `${base}images/Runner.gif`,
    alt: '勇者無懼 — Unity 2D 動作遊戲',
    useLightbox: false,
  },
  {
    id: 'learn5',
    titleZh: 'Doom 仿 3D',
    titleEn: 'Doom-style 3D',
    img: `${base}images/doom2D.gif`,
    alt: 'Doom 仿 3D — Pygame FPS 射擊遊戲',
    useLightbox: false,
  },
  {
    id: 'learn3',
    titleZh: '一番賞抽獎網站',
    titleEn: 'Lottery Website',
    img: `${base}images/01.png`,
    alt: '一番賞抽獎網站 — Laravel 全端專案',
    useLightbox: true,
    lightboxSrc: `${base}images/project1.gif`,
    lightboxTitle: '一番賞抽獎網站',
  },
];
---

<section id="portfolio" class="container py-5">
  <h2 class="text-end mb-4" data-zh="經驗亮點" data-en="Highlights">經驗亮點</h2>

  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    {projects.map((project) => (
      <div class="col">
        <div class="card portfolio-card h-100">

          {project.useLightbox ? (
            <a
              href={project.lightboxSrc}
              data-lightbox="portfolio"
              data-title={project.lightboxTitle}
            >
              <img src={project.img} class="card-img-top pixel-gif" alt={project.alt} />
            </a>
          ) : (
            <img src={project.img} class="card-img-top pixel-gif" alt={project.alt} />
          )}

          <div class="card-body">
            <h5 class="card-title">
              <span data-zh={project.titleZh} data-en={project.titleEn}>{project.titleZh}</span>
            </h5>
            <a class="btn btn-warning" id={project.id}>
              <span data-zh="內容" data-en="Detail">內容</span>
            </a>
          </div>

        </div>
      </div>
    ))}
  </div>
</section>
