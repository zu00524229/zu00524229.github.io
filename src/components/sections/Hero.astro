---
const base = import.meta.env.BASE_URL;
---

<header class="pixel-scene">
  <div class="scene-inner">

    <!-- 角色 -->
    <div class="scene-character">
      <img
        src={`${base}images/ninja.gif`}
        alt="Character"
      />
      <div class="scene-floor"></div>
    </div>

    <!-- 對話框 -->
    <div class="dialogue-box">
      <div class="dialogue-speaker">PLAYER_001</div>
      <div class="dialogue-content">
        <p class="d-line">
          <span data-zh="哈囉！！" data-en="Hello!!">哈囉！！</span>
        </p>
        <p class="d-line d-name">I'm Wen Chien.</p>
        <p class="d-line d-sub">
          <span
            data-zh="歡迎來到我的履歷，很高興認識你！"
            data-en="Welcome to my resume. Nice to meet you!"
          >歡迎來到我的履歷，很高興認識你！</span>
        </p>
      </div>
      <div class="dialogue-cursor">▶</div>
    </div>

  </div>
</header>

<style>
  .pixel-scene {
    min-height: 55vh;
    display: flex;
    align-items: center;
    padding: 90px 40px 20px;
  }

  .scene-inner {
    display: flex;
    align-items: flex-end;
    gap: 48px;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
  }

  /* 角色 */
  .scene-character {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scene-character img {
    width: 160px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    display: block;
  }

  /* 像素地板 */
  .scene-floor {
    width: 200px;
    height: 14px;
    background: repeating-linear-gradient(
      90deg,
      #3a1a00 0px, #3a1a00 16px,
      #2a1000 16px, #2a1000 32px
    );
    border-top: 3px solid #e86010;
  }

  /* 對話框 */
  .dialogue-box {
    flex: 1;
    border: 4px solid #ff7a1a;
    box-shadow: 8px 8px 0 #7a2800;
    background: #0d0808;
    margin-bottom: 14px;
  }

  .dialogue-speaker {
    background: #e86010;
    color: #000;
    font-family: 'Press Start 2P', cursive;
    font-size: 0.6rem;
    padding: 6px 14px;
    letter-spacing: 2px;
  }

  .dialogue-content {
    padding: 22px 26px;
    font-family: 'Press Start 2P', cursive;
    line-height: 2.4;
    color: #fff;
  }

  .d-line {
    margin: 0 0 8px 0;
    font-size: 0.75rem;
  }

  .d-name {
    color: #ff9944;
    font-size: 0.85rem;
  }

  .d-sub {
    font-size: 0.55rem;
    color: #bbb;
  }

  .dialogue-cursor {
    color: #ff7a1a;
    font-family: 'Press Start 2P', cursive;
    font-size: 0.65rem;
    padding: 0 26px 12px;
    animation: pixel-blink 1s steps(1) infinite;
  }

  /* RWD */
  @media (max-width: 640px) {
    .pixel-scene {
      padding: 90px 16px 20px;
    }
    .scene-inner {
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }
    .scene-character img {
      width: 110px;
    }
    .scene-floor {
      width: 150px;
    }
    .dialogue-box {
      margin-bottom: 0;
      width: 100%;
    }
    .d-line { font-size: 0.6rem; }
    .d-name { font-size: 0.7rem; }
    .d-sub  { font-size: 0.5rem; }
  }
</style>
