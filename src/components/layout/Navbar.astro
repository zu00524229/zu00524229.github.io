---
const base = import.meta.env.BASE_URL;
const navItems = [
  { href: '#about',     icon: 'fa-solid fa-user',         labelZh: '關於我',  labelEn: 'About'   },
  { href: '#MySkill',   icon: 'fa-solid fa-gamepad',       labelZh: '技能',    labelEn: 'Skills'  },
  { href: '#portfolio', icon: 'fa-solid fa-briefcase',     labelZh: '作品',    labelEn: 'Work'    },
  { href: '#contact',   icon: 'fa-solid fa-phone-volume',  labelZh: '聯絡',    labelEn: 'Contact' },
];
---

<nav
  class="navbar navbar-expand-lg"
  style="background-color: #000000; position: fixed; top: 0; left: 0; width: 100%; z-index: 1000;"
>
  <a class="navbar-brand" href="#">Touch</a>

  <!-- 漢堡選單按鈕 -->
  <button
    class="navbar-toggler"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#navbarNav"
    aria-controls="navbarNav"
    aria-expanded="false"
    aria-label="Toggle navigation"
  >
    <img src={`${base}images/menu.png`} alt="Menu" />
  </button>

  <!-- 導覽連結 -->
  <div class="collapse navbar-collapse" id="navbarNav">
    <ul class="navbar-nav ms-auto align-items-center">
      {navItems.map((item) => (
        <li class="nav-item">
          <!-- 桌面版：只顯示 icon -->
          <a class="nav-link text-white d-none d-lg-block" href={item.href}>
            <i class={item.icon}></i>
          </a>
          <!-- 手機版：顯示文字（支援語言切換） -->
          <a class="nav-link text-white d-block d-lg-none" href={item.href}>
            <span data-zh={item.labelZh} data-en={item.labelEn}>{item.labelZh}</span>
          </a>
        </li>
      ))}

      <!-- 留言板按鈕 -->
      <li class="nav-item">
        <button id="openFormBtn" class="btn btn-link text-white">
          <i class="fa-solid fa-comment-dots"></i>
        </button>
      </li>

      <!-- 語言切換 -->
      <li class="nav-item ms-2">
        <button id="lang-toggle" class="lang-btn">EN</button>
      </li>
    </ul>
  </div>
</nav>

<style>
  .lang-btn {
    background: transparent;
    border: 2px solid var(--yellow, #f8f060);
    color: var(--yellow, #f8f060);
    padding: 3px 10px;
    font-size: 0.55rem;
    font-family: 'Press Start 2P', cursive;
    cursor: pointer;
    border-radius: 0;
    box-shadow: 2px 2px 0 #000;
    transition: background 0.1s steps(1), color 0.1s steps(1);
  }
  .lang-btn:hover {
    background: var(--yellow, #f8f060);
    color: #000;
    box-shadow: none;
    transform: translate(2px, 2px);
  }
</style>
